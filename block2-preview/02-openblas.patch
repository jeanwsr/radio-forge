+
+            # Append env-provided cmake arguments (e.g. conda/rattler-build
+            # CMAKE_ARGS) so the conda build can control BLAS/LAPACK and the
+            # install prefix.
+            if os.environ.get("CMAKE_ARGS"):
+                cmake_args += os.environ["CMAKE_ARGS"].split()
+
+            # conda-forge OpenBLAS mangles Fortran BLAS/LAPACK symbols with a
+            # trailing underscore (daxpy_), so block2 needs _F77UNDERSCORE
+            # when not linking against MKL.
+            if os.environ.get("BLOCK2_USE_MKL", "ON") != "ON":
+                cmake_args += ["-DF77UNDERSCORE=ON"]

